# ============================================================
# 环境变量「模板」文件
#
# 这个文件是给别人看的说明书：告诉别人这个项目需要配哪些项。
# 里面只写「名字」，不写真实的值，所以可以放心上传。
#
# 用法：把它复制一份，改名为 .env，然后在 .env 里填真实的值。
# .env 已被 .gitignore 忽略，永远不会上传。
# ============================================================

# --- 数据库配置（第 23 天接入数据库时会用到）---
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- 网站配置 ---
SITE_URL=
